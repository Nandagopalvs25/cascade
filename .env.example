# Copy to .env and fill in. Every setting is documented in README.md.
# Local dev points at the docker-compose Postgres over TCP. On Cloud Run this
# value comes from Secret Manager and reaches Cloud SQL over a unix socket:
#   postgresql+asyncpg://cascade:<password>@/cascade?host=/cloudsql/<connection-name>
# Keep colons out of the password — they break asyncpg's DSN parser.
CASCADE_DATABASE_URL=postgresql+asyncpg://cascade:cascade@localhost:5432/cascade

CASCADE_GCP_PROJECT_ID=your-project-id
CASCADE_GCP_REGION=us-central1
CASCADE_GCP_GPU_REGION=europe-west1
CASCADE_GCS_BUCKET=cascade-your-project-id
CASCADE_PUBSUB_PUSH_SERVICE_ACCOUNT=cascade-pubsub-push@your-project-id.iam.gserviceaccount.com
CASCADE_PUBSUB_PUSH_AUDIENCE=https://cascade.us-central1.run.app

# https://trello.com/power-ups/admin — the API secret is the Power-Up OAuth
# secret used to verify webhook signatures, not the key and not the token.
CASCADE_TRELLO_API_KEY=
CASCADE_TRELLO_API_TOKEN=
CASCADE_TRELLO_API_SECRET=
CASCADE_TRELLO_BOARD_ID=
CASCADE_TRELLO_CALLBACK_URL=https://cascade.us-central1.run.app/webhooks/trello

CASCADE_TRELLO_LIST_TODO=
CASCADE_TRELLO_LIST_IN_PROGRESS=
CASCADE_TRELLO_LIST_RECOMMENDED=
CASCADE_TRELLO_LIST_NEEDS_ATTENTION=
CASCADE_TRELLO_LIST_DONE=

# Everything below has a default in config.py and can be omitted.
# CASCADE_GEMINI_MODEL=gemini-3.7-flash
# CASCADE_GEMINI_LOCATION=global
# CASCADE_MAX_LLM_CALLS_PER_INVOCATION=60
# CASCADE_MAX_LIGANDS_PER_CLOUD_RUN_JOB=50
# CASCADE_CONTROL_RMSD_THRESHOLD_ANGSTROM=2.0
# CASCADE_MAX_JOB_ATTEMPTS=2
